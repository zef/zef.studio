---
layout: default
---

<%
  scad = resource.data.scad
  worker_url = "/3d-printing/worker/worker.js?v=#{site.data[:scad_worker_version]}"
  preview = resource.data.image
  parameter_count = scad["groups"].sum { |group| group["parameters"].length }
  preset_count = scad["presets"]&.length || 0
  openscad_link = %(<a href="https://openscad.org">OpenSCAD</a>)
%>

<article class="model">
  <h1><%= resource.data.title %></h1>

  <p class="model-summary"><%= scad["summary"].to_s.tr("\n", " ") %></p>

  <scad-customizer
    class="scad-customizer"
    data-asset-base="/3d-printing"
    data-worker="<%= worker_url %>">
    <%# Raw, not escaped: this is JSON, not markup. The one sequence that could
        break out of a script element is neutralised. %>
    <script type="application/json"><%= scad.to_json.gsub("</", "<\\/").html_safe %></script>

    <div class="scad-viewport">
      <div class="scad-stage" data-role="stage">
        <canvas data-role="canvas" aria-label="3D preview of the <%= resource.data.title %>"></canvas>

        <div class="scad-poster" data-role="poster">
          <% if preview %>
            <img src="<%= preview %>" alt="Rendering of the <%= resource.data.title %>" loading="lazy">
          <% end %>
          <div class="scad-poster-prompt">
            <button type="button" class="scad-start" data-role="start">Customize This Model</button>
            <p>
              Runs OpenSCAD in your browser. Nothing is uploaded — the geometry is
              built on your own machine, which means a one-time download of about
              11&nbsp;MB.
            </p>
          </div>
        </div>

        <div class="scad-stage-bar">
          <p class="scad-status" data-role="status"></p>
          <button type="button" class="scad-ghost" data-role="recenter">Recenter</button>
        </div>
      </div>

      <div class="scad-source-panel" data-role="source-panel">
        <button type="button" class="scad-source-toggle" data-role="source-toggle" aria-expanded="false">
          View Source
        </button>
        <div class="scad-source highlight" data-language="OpenSCAD" data-role="source" hidden><pre><code></code></pre></div>
      </div>
    </div>

    <div class="scad-panel">
      <section class="scad-section" data-role="presets-panel">
        <h2>Templates</h2>
        <div class="scad-presets" data-role="presets"></div>
      </section>

      <section class="scad-section">
        <h2>
          Parameters
          <span class="scad-count"><%= parameter_count %></span>
          <label class="scad-switch" data-role="inch-switch">
            <input type="checkbox" data-role="inches">
            <span class="scad-switch-track"></span>
            <span class="scad-switch-label">inches</span>
          </label>
        </h2>
        <div class="scad-controls" data-role="controls"></div>
      </section>

      <section class="scad-section">
        <h2>Download</h2>
        <div class="scad-downloads">
          <div class="scad-parameter-row">
            <button type="button" class="scad-action is-primary" data-role="download-stl" disabled>Download .stl</button>
            <button type="button" class="scad-action" data-role="download-scad" disabled>Download .scad</button>
          </div>
          <p class="scad-note">
            The <code>.stl</code> is the printable file — open it in your slicer,
            PrusaSlicer or Bambu Studio or Cura, and send it to the printer. The
            <code>.scad</code> is the <%= openscad_link.html_safe %> source with your
            values written into it, if you want to take the design further.
          </p>
        </div>

        <div class="scad-parameter-file">
          <h3 class="scad-subhead">Parameter sets</h3>
          <div class="scad-parameter-row">
            <label class="scad-field-label" for="scad-preset-name">Name</label>
            <input type="text" id="scad-preset-name" class="scad-text" data-role="preset-name" value="customized">
          </div>
          <div class="scad-parameter-row">
            <button type="button" class="scad-action" data-role="download-preset" disabled>Download .json</button>
            <label class="scad-action scad-upload">
              Load
              <input type="file" accept="application/json,.json" data-role="upload-preset">
            </label>
            <button type="button" class="scad-action" data-role="share">Copy Link</button>
          </div>
          <p class="scad-note">
            These use <%= openscad_link.html_safe %>'s own <code>.json</code> customizer
            format, so they work here and in the desktop app. A copied link carries
            your settings and name too, with no file to pass around.
          </p>
          <p class="scad-upload-status" data-role="upload-status" hidden></p>
        </div>
      </section>

      <section class="scad-section">
        <h2>Stats</h2>
        <dl class="scad-stats" data-role="stats"></dl>

        <div data-role="computed-panel" hidden>
          <h3 class="scad-subhead">Calculated by the model</h3>
          <dl class="scad-stats" data-role="computed"></dl>
        </div>

        <p class="scad-note">
          Source: <a href="<%= scad["source_url"] %>"><%= scad["slug"] %>.scad</a><% if scad["libraries"].any? %>,
          built with <%= scad["libraries"].map { |name|
            url = scad["library_urls"]&.dig(name)
            url ? %(<a href="#{url}">#{name}</a>) : name
          }.join(", ").html_safe %><% end %>.
        </p>
      </section>

      <ul class="scad-problems" data-role="problems" hidden></ul>
    </div>
  </scad-customizer>

  <div class="model-notes">
    <% if resource.data.placeholder_prose %>
      <p class="model-placeholder-notice">
        <strong>Placeholder text.</strong> The writing below was generated as a
        sample to show the shape of this page. It isn’t Zef’s, and the first-person
        bits didn’t happen. Replace it and remove <code>placeholder_prose</code>
        from the front matter.
      </p>
    <% end %>

    <%= yield %>
  </div>

  <% photos = resource.data.photos || [] %>
  <% if photos.any? %>
    <section class="model-photos">
      <h2>Photos</h2>
      <%# Plain figures rather than a list: the site styles `ul:has(li > figure)`
          as its in-article image columns, which would fight this grid. %>
      <div class="model-photo-grid">
        <% photos.each do |photo| %>
          <figure>
            <a href="<%= photo["full"] %>"
               data-pswp-width="<%= photo["width"] %>"
               data-pswp-height="<%= photo["height"] %>">
              <img src="<%= photo["thumb"] %>" alt="<%= photo["caption"] || resource.data.title %>" loading="lazy">
            </a>
            <% if photo["caption"] %>
              <figcaption><%= photo["caption"] %></figcaption>
            <% end %>
          </figure>
        <% end %>
      </div>
    </section>
  <% end %>

  <p class="model-back"><a class="scad-action" href="/3d-printing/">All Models</a></p>
</article>
