<!doctype html>
<html lang="<%= site.locale %>">
  <head>
  <%= render "head" %>
  </head>
  <!--
  -->
  <%
    is_portfolio = resource.data.slug == 'portfolio'
    header_class = is_portfolio ? 'portfolio' : ''

    # The header is sized to the widest thing on the page. Content narrower
    # than the masthead is ordinary and reads as centred; content wider than it
    # reads as a mistake, because the eye gets two competing left edges with no
    # reason for either. So a page says how much room its content needs and the
    # header takes the same. Collections are card grids by definition; anything
    # else declares `width: wide` or `width: wider` in its front matter.
    width = resource.data.width || ("wide" if resource.data.layout == "collection")

    body_class = [
      ("section-portfolio" if is_portfolio),
      ("width-#{width}" if width),
    ].compact.join(" ")
  %>
  <body class="<%= body_class %>">
    <div class="content">
      <header class="<%= header_class %>">
        <div class="logo-container"><a class="logo" href="/"></a></div>
        <% if is_portfolio %>
          <a class="site-name" href="/"><%= site.metadata.title %></a>
          <p class="site-name-subtitle">Senior iOS App Developer &nbsp;•&nbsp; Boulder, Colorado</p>
        <% else %>
          <nav>
            <ul>
              <li><a href="/projects">Projects</a></li>
              <li><a href="/journal">Journal</a></li>
              <li><a href="/3d-printing">3D Printing</a></li>
              <li><a href="/about">About</a></li>
            </ul>
          </nav>
        <% end %>
      </header>
      <div class="body">
        <%= yield %>
      </div>
    </div>
    <footer>
      <div class="footer-content">
        <ul>
          <li><a class="icon twitter" href="https://twitter.com/zefhous/">@zefhous on Twitter</a></li>
          <li><a class="icon instagram" href="https://www.instagram.com/zefhous/">zefhous on Instagram</a></li>
          <li><a class="icon zef" href="/">Home</a></li>
          <li><a class="icon github" href="https://github.com/zef">zef on GitHub</a></li>
          <li><a class="icon email" href="mailto:zef@zef.studio">Email me at zef@zef.studio</a></li>
        </ul>
      </div>
    </footer>
    <script>if (window.location.host !== 'zef.studio') window.goatcounter = {no_onload: true}</script>
    <script data-goatcounter="https://zef.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>