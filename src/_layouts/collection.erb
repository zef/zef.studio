---
layout: default
---

<%
    heading = paginator ? paginator.documents.first.collection.label.titleize : title
    heading = nil if heading == "Index"
%>

<% unless heading.nil? %>
    <h1><%= heading %></h1>
<% end %>

<ul class="article-list">
    <%= yield %>
</ul>

<% if !paginator.nil? %>
    <%= render "pagination", paginator: paginator %>
<% end %>
