---
layout: default
---

<%
    if title == "Index"
        heading = nil 
    else
        heading = paginator ? paginator.documents.first.data.category.titleize : title
    end
%>

<% unless heading.nil? %>
    <h1><%= heading %></h1>
<% end %>

<ul class="article-list">
    <%= yield %>
</ul>

<% if !paginator.nil? %>
    <%= render "pagination", paginator: paginator %>
<% end %>
